# Copy to .env.local (gitignored). Production values live in Vercel environment variables.
DATABASE_URL=postgres://geomaster:geomaster@localhost:5432/geomaster
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google OAuth client (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Magic-link email via Resend; EMAIL_TRANSPORT=log prints links to the server log instead (dev only)
RESEND_API_KEY=
EMAIL_FROM=GEOMASTER <onboarding@resend.dev>
EMAIL_TRANSPORT=log
