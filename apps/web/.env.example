# Copy to .env.local (gitignored). Production values live in Vercel environment variables.
DATABASE_URL=postgres://geomaster:geomaster@localhost:5432/geomaster
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Core service (apps/core) base URL; core verifies service tokens against <BETTER_AUTH_URL>/api/auth/jwks
CORE_URL=http://localhost:8080
# Optional: service-token iss/aud (default BETTER_AUTH_URL); must match core's SERVICE_TOKEN_ISSUER/AUDIENCE
SERVICE_TOKEN_ISSUER=
SERVICE_TOKEN_AUDIENCE=
# Google OAuth client (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Magic-link email via Resend; EMAIL_TRANSPORT=log prints links to the server log instead (dev only)
RESEND_API_KEY=
EMAIL_FROM=GEOMASTER <onboarding@resend.dev>
EMAIL_TRANSPORT=log

# Public origin for canonical/hreflang URLs (defaults to BETTER_AUTH_URL).
SITE_URL=
